// Champion's Court Arena Map
// Data-driven scene layout for a Bevy arena brawler.
// Coordinate convention:
//   - Bevy world axes: X = left/right, Y = up, Z = forward/back
//   - Tile coordinates are on X/Z. world_x = tile_x * tile_size, world_z = tile_z * tile_size.
//   - Angles are degrees around Bevy's Y axis.
//
// Suggested renderer behavior:
//   1. Load assets from `assets`.
//   2. Expand `floor_shapes` into floor instances.
//   3. Spawn `instances` and `prefab_instances`.
//   4. Apply collider rules by tag/asset.
//   5. Spawn gameplay zones, player spawns, lighting, camera.
//
// This file intentionally favors readability and Codex-friendly implementation over minimal size.

(
    schema_version: 1,

    map: (
        id: "champions_court",
        name: "Champion's Court",
        description: "A stylized ruined fortress arena with a central trophy plaza, raised side platforms, gates, banners, columns, trees, and a statue dais.",
        tile_size: 2.0,
        coordinate_system: "bevy_xzy",
        theme: "stylized_ruined_fortress_arena",
        recommended_modes: ["1v1", "2v2", "ffa_4"],
        recommended_player_count: 4,
    ),

    asset_root: "models/",

    assets: {
        "banner": "banner.glb",
        "block": "block.glb",
        "border_corner": "border-corner.glb",
        "border_straight": "border-straight.glb",
        "bricks": "bricks.glb",
        "soldier": "character-soldier.glb",
        "column_damaged": "column-damaged.glb",
        "column": "column.glb",
        "floor_detail": "floor-detail.glb",
        "floor": "floor.glb",
        "stairs_corner_inner": "stairs-corner-inner.glb",
        "stairs_corner": "stairs-corner.glb",
        "stairs": "stairs.glb",
        "statue": "statue.glb",
        "tree": "tree.glb",
        "trophy": "trophy.glb",
        "wall_corner": "wall-corner.glb",
        "wall_gate": "wall-gate.glb",
        "wall": "wall.glb",
        "weapon_rack": "weapon-rack.glb",
        "weapon_spear": "weapon-spear.glb",
        "weapon_sword": "weapon-sword.glb",
    },

    // Optional material/color guidance. Your Bevy loader can ignore this at first.
    palette: (
        source_image: "palettes/colormap.png",
        notes: "Warm sandstone, muted red-orange banners, green overgrowth, cool blue-purple shadows.",
        colors: {
            "stone_warm": (0.78, 0.62, 0.45, 1.0),
            "stone_light": (0.92, 0.80, 0.63, 1.0),
            "banner_red": (0.70, 0.18, 0.12, 1.0),
            "foliage_green": (0.28, 0.55, 0.34, 1.0),
            "shadow_purple": (0.34, 0.32, 0.55, 1.0),
            "gold_trim": (0.95, 0.67, 0.24, 1.0),
        },
    ),

