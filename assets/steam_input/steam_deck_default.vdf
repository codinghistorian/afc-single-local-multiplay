"controller_mappings"
{
    "version"         "3"
    "revision"        "0"
    "title"           "Animal Fighter Club — Steam Deck"
    "description"     "Official gameplay and menu layout"
    "creator"         "0"
    "controller_type" "controller_neptune"
    "major_revision"  "1"
    "minor_revision"  "0"

    "group"
    {
        "id"   "0"
        "mode" "four_buttons"
        "inputs"
        {
            "button_A"
            {
                "activators" { "Full_Press" { "bindings" { "binding" "game_action Gameplay Jump, Jump" } } }
            }
            "button_B"
            {
                "activators" { "Full_Press" { "bindings" { "binding" "game_action Gameplay AimGrab, Aim / Grab" } } }
            }
            "button_X"
            {
                "activators" { "Full_Press" { "bindings" { "binding" "game_action Gameplay Light, Light Attack" } } }
            }
            "button_Y"
            {
                "activators" { "Full_Press" { "bindings" { "binding" "game_action Gameplay Heavy, Heavy Attack" } } }
            }
        }
    }
    "group"
    {
        "id"   "1"
        "mode" "dpad"
        "inputs"
        {
            "dpad_north" { "activators" { "Full_Press" { "bindings" { "binding" "game_action Gameplay Up, Move / Dash Up" } } } }
            "dpad_south" { "activators" { "Full_Press" { "bindings" { "binding" "game_action Gameplay Down, Move / Dash Down" } } } }
            "dpad_west"  { "activators" { "Full_Press" { "bindings" { "binding" "game_action Gameplay Left, Move / Dash Left" } } } }
            "dpad_east"  { "activators" { "Full_Press" { "bindings" { "binding" "game_action Gameplay Right, Move / Dash Right" } } } }
        }
    }
    "group"
    {
        "id"   "2"
        "mode" "joystick_move"
        "inputs" { }
        "settings" { "virtual_mode" "1" }
        "gameactions" { "Gameplay" "Move" }
    }
    "group"
    {
        "id"   "3"
        "mode" "switches"
        "inputs"
        {
            "button_escape"
            {
                "activators" { "Full_Press" { "bindings" { "binding" "game_action Gameplay MenuBack, Menu Back" } } }
            }
            "button_menu"
            {
                "activators" { "Full_Press" { "bindings" { "binding" "game_action Gameplay MenuBindings, Controller Layout" } } }
            }
        }
    }
    "group"
    {
        "id"   "4"
        "mode" "four_buttons"
        "inputs"
        {
            "button_A"
            {
                "activators" { "Full_Press" { "bindings" { "binding" "game_action Menu MenuAccept, Menu Accept" } } }
            }
            "button_B"
            {
                "activators" { "Full_Press" { "bindings" { "binding" "game_action Menu MenuBack, Menu Back" } } }
            }
            "button_X"
            {
                "activators" { "Full_Press" { "bindings" { "binding" "game_action Menu MenuBindings, Controller Layout" } } }
            }
        }
    }
    "group"
    {
        "id"   "5"
        "mode" "dpad"
        "inputs"
        {
            "dpad_north" { "activators" { "Full_Press" { "bindings" { "binding" "game_action Menu MenuUp, Menu Up" } } } }
            "dpad_south" { "activators" { "Full_Press" { "bindings" { "binding" "game_action Menu MenuDown, Menu Down" } } } }
            "dpad_west"  { "activators" { "Full_Press" { "bindings" { "binding" "game_action Menu MenuLeft, Menu Left" } } } }
            "dpad_east"  { "activators" { "Full_Press" { "bindings" { "binding" "game_action Menu MenuRight, Menu Right" } } } }
        }
    }
    "group"
    {
        "id"   "6"
        "mode" "switches"
        "inputs"
        {
            "button_escape"
            {
                "activators" { "Full_Press" { "bindings" { "binding" "game_action Menu MenuBack, Menu Back" } } }
            }
            "button_menu"
            {
                "activators" { "Full_Press" { "bindings" { "binding" "game_action Menu MenuBindings, Controller Layout" } } }
            }
        }
    }

    "preset"
    {
        "id"   "0"
        "name" "Gameplay"
        "group_source_bindings"
        {
            "0" "button_diamond active"
            "1" "dpad active"
            "2" "joystick active"
            "3" "switch active"
        }
    }
    "preset"
    {
        "id"   "1"
        "name" "Menu"
        "group_source_bindings"
        {
            "4" "button_diamond active"
            "5" "dpad active"
            "6" "switch active"
        }
    }
    "settings" { }
}
