"AppBuild"
{
    "AppID" "@@APP_ID@@"
    "Desc" "@@DESCRIPTION@@"
    "Preview" "1"
    "BuildOutput" "@@BUILD_OUTPUT@@"
    "Depots"
    {
        "@@WINDOWS_DEPOT_ID@@" "@@WINDOWS_DEPOT_VDF@@"
        "@@LINUX_DEPOT_ID@@" "@@LINUX_DEPOT_VDF@@"
        "@@MACOS_DEPOT_ID@@" "@@MACOS_DEPOT_VDF@@"
    }
}
